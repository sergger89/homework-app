# Скопируйте этот файл в .env и заполните своими значениями
SESSION_SECRET=любая-длинная-случайная-строка

# Единственный аккаунт, который создаётся автоматически при первом запуске.
# Войдите под ним и создайте аккаунты родителей и детей в панели администратора.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=надежный-пароль
ADMIN_NAME=Администратор

# Если забыли пароль администратора: впишите новый в ADMIN_PASSWORD выше, поставьте
# RESET_ADMIN_PASSWORD=true, перезапустите контейнер, войдите — и не забудьте убрать
# эту строчку (или поставить false) после этого, иначе пароль будет сбрасываться
# на каждом перезапуске контейнера.
RESET_ADMIN_PASSWORD=false
